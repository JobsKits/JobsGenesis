# 记录本仓库子模块的路径、远端地址和默认分支。
# 同组织同名仓库使用相对 URL，跟随父仓默认远端的平台、账号和协议。
# 从 Gitee 克隆时递归走 Gitee；SourceTree.command 对应的远端仓库名是 SourceTree.sh。
[submodule "JobsCommand@Flutter"]
	path = JobsCommand@Flutter
	url = ../JobsCommand-Flutter.git
	branch = main
[submodule "JobsCommand@Gits"]
	path = JobsCommand@Gits
	url = ../JobsCommand-Gits.git
	branch = main
[submodule "JobsCommand@iOS"]
	path = JobsCommand@iOS
	url = ../JobsCommand-iOS.git
	branch = main
[submodule "JobsCommand@Others"]
	path = JobsCommand@Others
	url = ../JobsCommand-Others.git
	branch = main
[submodule "JobsConfigOS"]
	path = JobsConfigOS
	url = ../JobsConfigOS.git
	branch = main
[submodule "JobsPythonTools.py"]
	path = JobsPythonTools.py
	url = ../JobsPythonTools.git
	branch = main
[submodule "JobsSh.sh"]
	path = JobsSh.sh
	url = ../JobsSh.git
	branch = main
[submodule "MacOS@Extension"]
	path = OS@Extension/MacOS@Extension
	url = ../MacOS_Extension.git
	branch = main
[submodule "SourceTree.command"]
	path = SourceTree.command
	url = ../SourceTree.sh.git
	branch = main
[submodule "WindowsOS@Extension"]
	path = OS@Extension/WindowsOS@Extension
	url = ../WindowsOS_Extension.git
	branch = main
